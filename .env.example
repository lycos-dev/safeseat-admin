# SafeSeat Admin V1.3
# Use the SAME Firebase project as safeseat-app.
# Copy to .env and fill using the matching values from the existing safeseat-app .env.

# demo | firebase
VITE_DATA_MODE=demo

# Demo-only credentials (used only when VITE_DATA_MODE=demo)
VITE_DEMO_ADMIN_EMAIL=admin@safeseat.demo
VITE_DEMO_ADMIN_PASSWORD=SafeSeat2026!

# Firebase Web configuration (same project as safeseat-app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Privacy-minimized Admin collections.
# account_directory is intentionally separate from the mobile app's private user/profile documents.
VITE_FIRESTORE_ACCOUNT_DIRECTORY_COLLECTION=account_directory
VITE_FIRESTORE_ADMINS_COLLECTION=admin_accounts
VITE_FIRESTORE_VEHICLES_COLLECTION=vehicles
VITE_FIRESTORE_SESSIONS_COLLECTION=monitoring_sessions
VITE_FIRESTORE_INCIDENTS_COLLECTION=incidents
VITE_FIRESTORE_HARDWARE_COLLECTION=hardware_status
VITE_FIRESTORE_SETTINGS_COLLECTION=admin_settings
VITE_FIRESTORE_DIAGNOSTICS_COLLECTION=diagnostic_requests
