# SafeSeat Admin V1.1 currently runs in local demo mode.
# Keep UI data access separated from page components so a backend/Firebase
# repository can replace local demo storage without redesigning the screens.
VITE_SAFESEAT_DATA_MODE=local

# Demo-only authentication. Do not use these values for production deployment.
VITE_DEMO_ADMIN_EMAIL=admin@safeseat.demo
VITE_DEMO_ADMIN_PASSWORD=SafeSeat2026!
